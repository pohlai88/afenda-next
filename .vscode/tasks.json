{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Afenda: clean artifacts dry-run",
      "type": "shell",
      "command": "pnpm clean:artifacts:dry-run",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Afenda: clean artifacts",
      "type": "shell",
      "command": "pnpm clean:artifacts",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Afenda: check architecture",
      "type": "shell",
      "command": "pnpm check:architecture",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Afenda: typecheck",
      "type": "shell",
      "command": "pnpm typecheck",
      "group": "build",
      "problemMatcher": "$tsc"
    },
    {
      "label": "Afenda: lint",
      "type": "shell",
      "command": "pnpm lint",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Afenda: test",
      "type": "shell",
      "command": "pnpm test",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Afenda: check",
      "type": "shell",
      "command": "pnpm check",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Afenda: build",
      "type": "shell",
      "command": "pnpm build",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Afenda: vercel link",
      "type": "shell",
      "command": "pnpm vercel link",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Afenda: vercel env pull",
      "type": "shell",
      "command": "pnpm vercel env pull .env.local",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Afenda: vercel deploy",
      "type": "shell",
      "command": "pnpm vercel deploy --prebuilt --yes",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Afenda: vercel deploy (prod)",
      "type": "shell",
      "command": "pnpm vercel deploy --prod --prebuilt --yes",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Afenda: vercel open",
      "type": "shell",
      "command": "pnpm vercel open",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Afenda: dev",
      "type": "shell",
      "command": "pnpm dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "next",
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*Ready.*"
        }
      }
    }
  ]
}
