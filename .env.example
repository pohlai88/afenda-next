# =============================================================================
# afenda-next — environment template
# =============================================================================
# Local development is managed through `.env.config`; run `pnpm env:sync`
# to generate `.env.local`. Do not commit real secrets.
# Runtime validation lives in `src/env.js`.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime contract (src/env.js)
# -----------------------------------------------------------------------------
# Required: DATABASE_URL
# Production: BETTER_AUTH_SECRET (or AUTH_SECRET)
# Auth origin: BETTER_AUTH_URL or AUTH_URL (BETTER_AUTH_* wins)
# OAuth aliases: `pnpm env:sync` mirrors legacy provider keys into BETTER_AUTH_*

# -----------------------------------------------------------------------------
# Core (local dev)
# -----------------------------------------------------------------------------
APP_BASE_URL="http://localhost:3000"
LOG_LEVEL="debug"
NEXT_PUBLIC_APP_NAME="Afenda"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STAGE="dev"

# -----------------------------------------------------------------------------
# Production (deployment example)
# -----------------------------------------------------------------------------
# Canonical origin ADR 0002: BETTER_AUTH_URL
# APP_BASE_URL="https://erp.example.com"
# AUTH_URL="https://erp.example.com"
# BETTER_AUTH_SECRET=""
# BETTER_AUTH_URL="https://erp.example.com"
# NEXT_PUBLIC_APP_URL="https://erp.example.com"
# NEXT_PUBLIC_TENANT_ROOT_DOMAIN="example.com"
# TENANT_ROOT_DOMAIN="example.com"

# -----------------------------------------------------------------------------
# Feature flags (not in src/env.js yet)
# -----------------------------------------------------------------------------
ENABLE_AI_FEATURES="false"
ENABLE_CUSTOM_DOMAIN="false"
ENABLE_CUSTOM_DOMAIN_ROUTING="false"
ENABLE_SELF_SERVICE_TENANT_CREATE="false"
# MIDDLEWARE_TENANT_LOOKUP_SECRET=""

# -----------------------------------------------------------------------------
# Database (Neon / Drizzle)
# -----------------------------------------------------------------------------
NEON_BRANCH_ID=""
NEON_BRANCH_NAME=""
NEON_DATABASE_NAME=""
NEON_ENDPOINT_ID=""
NEON_PROJECT_ID=""
NEON_ROLE_NAME=""
DATABASE_URL="postgresql://postgres:password@localhost:5432/afenda-exp"
DATABASE_URL_DIRECT=""

# -----------------------------------------------------------------------------
# Multi-tenant host (local: {slug}.localhost)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_TENANT_ROOT_DOMAIN="localhost"
TENANT_ROOT_DOMAIN="localhost"

# -----------------------------------------------------------------------------
# Better Auth
# -----------------------------------------------------------------------------
# Required for Better Auth Infrastructure dashboard / dash() plugin.
BETTER_AUTH_API_KEY=""
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
AUTH_SECRET=""
AUTH_URL=""

# -----------------------------------------------------------------------------
# OAuth — Better Auth social and legacy aliases
# -----------------------------------------------------------------------------
BETTER_AUTH_GITHUB_CLIENT_ID=""
BETTER_AUTH_GITHUB_CLIENT_SECRET=""
BETTER_AUTH_GOOGLE_CLIENT_ID=""
BETTER_AUTH_GOOGLE_CLIENT_SECRET=""
BETTER_AUTH_LINKEDIN_CLIENT_ID=""
BETTER_AUTH_LINKEDIN_CLIENT_SECRET=""
GITHUB_INTEGRATION_CLIENT_ID=""
GITHUB_INTEGRATION_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Optional stubs — PDF / local tooling
# -----------------------------------------------------------------------------
# PDF_DOCS_DIR="content/i18n/docs"
# PDF_HOST="http://localhost:3000"
# PDF_OUT_DIR=".artifacts/docs-pdf"
# PUPPETEER_CACHE_DIR=".artifacts/puppeteer"

# -----------------------------------------------------------------------------
# Optional stubs — AI (not in src/env.js)
# -----------------------------------------------------------------------------
# AI_GATEWAY_API_KEY=""
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""

# -----------------------------------------------------------------------------
# Cloudflare R2 (S3-compatible API)
# -----------------------------------------------------------------------------
STORAGE_PROVIDER="r2"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_ENDPOINT=""
# R2_PUBLIC_BASE_URL=""
# R2_BACKUP_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_BUCKET=""
S3_ENDPOINT=""
S3_REGION="auto"
S3_SECRET_ACCESS_KEY=""

# -----------------------------------------------------------------------------
# Optional stubs — observability / AWS (not R2)
# -----------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=""
# AWS_REGION="us-east-1"
# AWS_SECRET_ACCESS_KEY=""
# AWS_S3_BUCKET=""
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_DSN=""

# -----------------------------------------------------------------------------
# Deployment / CLI (not Next.js runtime)
# -----------------------------------------------------------------------------
TURBO_TEAM=""
TURBO_TOKEN=""
VERCEL_TOKEN=""

# -----------------------------------------------------------------------------
# Tolgee (not in src/env.js yet)
# -----------------------------------------------------------------------------
PROJECT_API_KEY=""
TOLGEE_PERSONAL_ACCESS_TOKEN=""
# TOLGEE_API_URL=""
# TOLGEE_PROJECT_ID=""

# -----------------------------------------------------------------------------
# Third-party dev (IDE / MCP / design)
# -----------------------------------------------------------------------------
FIGMA_API_KEY=""
GITHUB_MCP_PAT=""

# -----------------------------------------------------------------------------
# Build / CI
# -----------------------------------------------------------------------------
# SKIP_ENV_VALIDATION="1"
# AFENDA_E2E_SKIP_AUTH_GUARD="true"
