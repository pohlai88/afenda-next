{
  "mcpServers": {
    "React Aria": {
      "command": "npx",
      "args": [
        "@react-aria/mcp@latest"
      ]
    },
    "next-devtools": {
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"],
      "env": {
        "SystemRoot": "C:\\Windows",
        "PROGRAMFILES": "C:\\Program Files"
      }
    }
  }
}